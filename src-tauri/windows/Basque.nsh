LangString newerVersionInstalled ${LANG_BASQUE} "${PRODUCTNAME}-ren bertsio berriago bat instalatuta dago! Ez da gomendatzen bertsio zaharrago bat instalatzea. Benetan instalatu nahi baduzu, hobe da lehenik uneko bertsioa desinstalatzea. Hautatu egin nahi duzun eragiketa eta sakatu Hurrengoa jarraitzeko."
LangString older ${LANG_BASQUE} "zaharrago"
LangString olderOrUnknownVersionInstalled ${LANG_BASQUE} "${PRODUCTNAME}-ren bertsio $R4 bat instalatuta dago sisteman. Gomendagarria da uneko bertsioa desinstalatzea instalatu aurretik. Hautatu egin nahi duzun eragiketa eta sakatu Hurrengoa jarraitzeko."
LangString silentDowngrades ${LANG_BASQUE} "Instalatzaile honek ez du bertsio zaharragora itzultzen uzten; ezin da isilpeko instalazioarekin jarraitu. Erabili interfaze grafikoa duen instalatzailea.$\n"
