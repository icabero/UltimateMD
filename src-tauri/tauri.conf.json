{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UltimateMD",
  "version": "0.7.2",
  "identifier": "dev.ultimatemd.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run sidecar && npm run build:web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: umd: http://umd.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: https://api.github.com",
        "worker-src": "'self' blob:",
        "frame-src": "umd: http://umd.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Markdown vaults with diagrams and MCP",
    "longDescription": "Edit Markdown and HTML notes in vaults, keep several open at once, and connect them to AI assistants through MCP.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ultimatemd-mcp"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "English",
          "Spanish",
          "Basque"
        ],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "Basque": "windows/Basque.nsh"
        },
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "description": "Documento Markdown",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "ultimatemd.desktop"
      },
      "rpm": {
        "desktopTemplate": "ultimatemd.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2QjQ0RkY0MjlDOTE0QzQKUldURUZNa3A5RSswWnBXd0padE1zT0NVSGthSDkvc1FaSWVKVHo1R1NBM3E1eFRFeFRYK2tRVWIK",
      "endpoints": [
        "https://github.com/icabero/UltimateMD/releases/latest/download/latest.json"
      ]
    }
  }
}
